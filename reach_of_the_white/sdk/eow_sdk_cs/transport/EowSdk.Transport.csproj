<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EowSdk.Transport</RootNamespace>
    <AssemblyName>EowSdk.Transport</AssemblyName>
    <PackageId>EowSdk.Transport</PackageId>
    <Version>1.0.0</Version>
    <Description>Multi-instance client transport between EOW_SDK and Echoes_of_the_White.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="instance.json" LogicalName="EowSdk.Transport.instance.json" />
  </ItemGroup>
</Project>
